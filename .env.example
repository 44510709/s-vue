# ==========================================================================
# 环境变量模板 (.env.example)
#
# 使用说明:
#   1. 本文件只是模板, Vite 不会自动加载它。请复制成实际使用的文件:
#        cp .env.example .env.development   # 开发环境
#        cp .env.example .env.production    # 生产环境
#   2. .env / .env.* 已被 .gitignore 忽略, 真实值禁止提交仓库。
#   3. 只有 VITE_ 前缀的变量会被注入前端 (import.meta.env.*),
#      其值会被打包进产物, 因此这里禁止放置任何服务端密钥或敏感凭据。
#   4. 注释中标注的 dev / prod 差异, 指同一配置项在两种模式下的不同取值方式。
# ==========================================================================


# --------------------------------------------------------------------------
# 基础信息
# --------------------------------------------------------------------------

# 页面标题: 浏览器标签页标题, 并参与动态标题拼接
VITE_APP_TITLE = 'RuoYi-Vue-Plus后台管理系统'

# 侧边栏 Logo 旁显示的简称
VITE_APP_LOGO_TITLE = 'RuoYi-Vue-Plus'


# --------------------------------------------------------------------------
# 部署路径与接口地址
# --------------------------------------------------------------------------

# 应用访问路径 (vite base): 应用部署在子路径时填写, 例如 '/admin/'
# 同时作为 vue-router 的 history base
VITE_APP_CONTEXT_PATH = '/'

# 开发服务器端口 (vite server.port)
VITE_APP_PORT = 80

# 接口基础路径 (axios baseURL, 上传/下载/推送等均基于它拼接)
#   dev : 作为 vite 开发代理的前缀, 请求会被转发到本地后端服务
#   prod: 生产环境接口前缀, 由网关或反向代理转发
VITE_APP_BASE_API = '/dev-api'


# --------------------------------------------------------------------------
# 关联控制台地址
# 统一规则: 开发环境填独立服务的完整地址, 生产环境填与前端同域的相对路径
# --------------------------------------------------------------------------

# Spring Boot Admin 监控控制台地址
VITE_APP_MONITOR_ADMIN = 'https://monitor.example.com/admin/applications'

# SnailJob 任务调度控制台地址
VITE_APP_SNAILJOB_ADMIN = 'https://snailjob.example.com/snail-job'

# SnailAI 控制台地址
# 注意: 当前前端已移除 AI 控制台入口, 该配置暂时没有被代码引用,
#       保留是为了便于后续恢复时直接使用
VITE_APP_SNAILAI_ADMIN = 'https://snailai.example.com/snail-ai'


# --------------------------------------------------------------------------
# 客户端认证
# --------------------------------------------------------------------------

# 客户端 id: 需与后端 oauth2 客户端配置中的 client-id 完全一致
# 属于凭据信息, 请按实际环境填写, 不要沿用示例值提交
VITE_APP_CLIENT_ID = 'your-client-id'


# --------------------------------------------------------------------------
# 接口加密
# --------------------------------------------------------------------------

# 接口加密总开关: 取值 'true' / 'false' (字符串比较, 请勿写成布尔大写 TRUE)
# 关闭时后端也必须同步关闭, 否则接口会因无法解密而报错
VITE_APP_ENCRYPT = true

# 接口加密使用的 RSA 公钥, 与后端解密私钥成对, 更换时前后端需同步更换
# 前端只持有公钥: 仅用公钥加密一次性 AES 密钥 (请求体加密),
# 响应体不再加密, 前端不做解密, 因此不存在也不需要私钥配置
#
# !! 下面这行是占位符, 不是真实公钥, 必须替换后才能启动前端 !!
#    未替换时前端会用占位串加密, 后端解密失败, 表现为登录/改密接口
#    返回 403 "没有访问权限，请联系管理员授权" (看着像权限问题, 实际是密钥不匹配)
#    真实公钥取自后端: ruoyi-vue-plus/.env 中 RUOYI_API_DECRYPT_PRIVATE_KEY
#    对应的公钥, 或直接向后端负责人索取
VITE_APP_RSA_PUBLIC_KEY = 'MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA<placeholder,请向后端获取真实公钥>'


# --------------------------------------------------------------------------
# 统一消息推送
# --------------------------------------------------------------------------

# 统一消息推送开关: 取值 'true' / 'false'
VITE_APP_MESSAGE_ENABLED = true

# 消息推送传输方式: 'sse' 或 'websocket'
VITE_APP_MESSAGE_TRANSPORT = 'sse'

# 消息推送接口路径
VITE_APP_MESSAGE_PATH = '/resource/message'


# --------------------------------------------------------------------------
# 构建相关
# --------------------------------------------------------------------------

# 打包时开启的压缩方式: 支持 gzip 和 brotli, 多个用英文逗号分隔, 留空则不压缩
# 仅在生产构建 (build) 时生效
VITE_BUILD_COMPRESS = gzip


# --------------------------------------------------------------------------
# 以下配置当前未被代码引用, 仅保留占位, 按需修改
# --------------------------------------------------------------------------

# 环境标识: 复制到 .env.development 填 'development', 复制到 .env.production 填 'production'
# Vite 已内置 import.meta.env.MODE, 当前业务代码未引用本变量
VITE_APP_ENV = 'development'
